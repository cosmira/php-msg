{
  "name": "tabuna/msg-viewer",
  "description": "Microsoft Outlook MSG parser rewritten in modern PHP",
  "keywords": ["msg", "outlook", "email", "parser", "php", "laravel"],
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.2",
    "brick/math": "^0.12|^0.13|^0.14",
    "illuminate/support": "v12.37.0"
  },
  "autoload": {
    "psr-4": {
      "MsgViewer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MsgViewer\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5|^12.0",
    "symfony/var-dumper": "^7.0",
    "laravel/pint": "^1.2",
    "infection/infection": "^0.32.6",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "rector/rector": "^2.3"
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
