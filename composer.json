{
  "name": "tabuna/msg-viewer",
  "description": "Microsoft Outlook MSG parser rewritten in modern PHP",
  "keywords": ["msg", "outlook", "email", "parser", "php", "laravel"],
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.2",
    "brick/math": "^0.11"
  },
  "autoload": {
    "psr-4": {
      "MsgViewer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MsgViewer\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "bin": [
    "bin/parse-msg.php"
  ],
  "minimum-stability": "stable"
}

