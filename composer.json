{
  "name": "cosmira/outlook-msg",
  "description": "Read and write Microsoft Outlook MSG files in modern PHP",
  "keywords": ["msg", "outlook", "email", "reader", "writer", "php", "laravel"],
  "license": "MIT",
  "type": "library",
  "require": {
    "php": "^8.2",
    "brick/math": "^0.12|^0.13|^0.14|^0.15|^0.16|^0.17|^0.18",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "autoload": {
    "psr-4": {
      "Cosmira\\OutlookMessage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cosmira\\OutlookMessage\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5|^12.0|^13.0",
    "symfony/var-dumper": "^7.0|^8.0",
    "laravel/pint": "^1.2",
    "infection/infection": "^0.32|^0.33",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "rector/rector": "^2.3",
    "driftingly/rector-laravel": "^2.1"
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
